{
  "name": "open-rally",
  "private": true,
  "version": "1.38.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-web-build.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b --noEmit && oxlint && vitest run",
    "preview": "vite preview",
    "build:android": "./build-apk.sh",
    "open:android": "npx cap open android",
    "build:apk": "./build-apk.sh",
    "build:bundle": "./build-bundle.sh",
    "build:release": "./build-bundle.sh",
    "generate:key": "./generate-release-key.sh",
    "version:patch": "node scripts/bumpVersion.mjs patch",
    "version:minor": "node scripts/bumpVersion.mjs minor",
    "version:major": "node scripts/bumpVersion.mjs major",
    "version:set": "node scripts/bumpVersion.mjs",
    "check:web": "tsc -b --noEmit && oxlint && vitest run --maxWorkers=2 --testTimeout=15000 --exclude tests/adversarial_m8_challenger2.test.ts --exclude tests/e2e/apk_validator.test.ts",
    "check:android": "vitest run tests/adversarial_m8_challenger2.test.ts tests/e2e/apk_validator.test.ts --maxWorkers=2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@types/three": "^0.185.1",
    "lucide-react": "^1.24.0",
    "postprocessing": "6.39.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1",
    "three-stdlib": "2.36.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@dimforge/rapier3d-compat": "0.19.2",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "draco3dgltf": "^1.5.7",
    "ffmpeg-static": "^5.3.0",
    "meshoptimizer": "^1.2.0",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  },
  "description": "Aeroline multiplayer browser driving game, based on OpenRally",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/space-explorer-4231/afterglow-rally-game.git",
    "directory": "source"
  },
  "homepage": "https://aeroline-road-club.aeroline-edge.workers.dev/"
}
