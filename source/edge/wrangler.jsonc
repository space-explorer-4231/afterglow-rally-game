{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeroline-your-fork",
  "main": "../server/worker/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ws",
      "/health",
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RALLY",
        "class_name": "RallyRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RallyRelay"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
