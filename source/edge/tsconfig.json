{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["../server/worker/**/*.ts", "../server/src/**/*.ts"],
  "exclude": ["../server/src/server.ts", "../server/src/**/*.test.ts"]
}
